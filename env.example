# Copy this file to ".env" and edit the values.
# Command line flags (python main.py --help) override these.

# --- YouTube ---------------------------------------------------------------
# Live video ID or full URL.  Leave empty for DEMO mode.
YT_VIDEO=
# "pytchat" = no API key needed (recommended)   |   "api" = official Data API v3
YT_BACKEND=pytchat
YT_API_KEY=
YT_API_POLL=10

# --- Server ----------------------------------------------------------------
PORT=8080

# --- Scoring -----------------------------------------------------------------
USER_COOLDOWN=2
MAX_COUNTRIES=1
SUPERCHAT_POINTS_PER_USD=100
MEMBER_POINTS=400

# --- Announcer ---------------------------------------------------------------
# edge | pyttsx3 | browser | off
TTS_ENGINE=edge
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+8%
TTS_PITCH=+0Hz
# skip = say "a viewer" for Persian/Arabic/... names, speak = try to read them
NON_LATIN_NAMES=skip
REMINDER_MINUTES=7
STANDINGS_MINUTES=5

# --- Look --------------------------------------------------------------------
TITLE=BOOST YOUR COUNTRY
